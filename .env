# Spec enforcement defaults
SPEC_CODE_MAX_LINES=150
SPEC_DOCS_MAX_LINES=500
SPEC_CODE_EXTENSIONS=.js,.css
SPEC_DOCS_EXTENSIONS=.md
SPEC_IGNORE_DIRS=node_modules,src/vendor,.git,.configs

# Server — override any of these in .env.local (git-ignored).
# Full reference: docs/app-spec/CONFIGURATION.md
PORT=6556

# AI director LLM: ollama | openai (any OpenAI-compatible server) | none
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# Transcription: auto | whisper-cpp | faster-whisper | openai | ssh | none
TRANSCRIBE_PROVIDER=auto
WHISPER_MODEL=base

# Visual tagging: ollama | openai | none
VISION_PROVIDER=ollama
VISION_MODEL=llava:7b

# Global media paths (comma-separated absolute paths)
# These are available to all projects (logos, intros, sound bites)
GLOBAL_MEDIA_PATHS=
