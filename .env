# Spec enforcement defaults
SPEC_CODE_MAX_LINES=150
SPEC_DOCS_MAX_LINES=500
SPEC_CODE_EXTENSIONS=.js,.css
SPEC_DOCS_EXTENSIONS=.md
SPEC_IGNORE_DIRS=node_modules,src/vendor,.git,.configs

# Server
PORT=6556
SERVER_HOST=192.168.86.26

# Ollama (local LLM for AI director)
OLLAMA_URL=http://192.168.86.65:11434
OLLAMA_MODEL=qwen3:14b

# Hydra GPU server
HYDRA_HOST=hydra
WHISPER_MODEL=medium
VISION_MODEL=llava:7b

# Global media paths (newline-separated absolute paths)
# These are available to all projects (logos, intros, sound bites)
GLOBAL_MEDIA_PATHS=
