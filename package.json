{
  "name": "nearedit",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "test": "node scripts/test.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "postinstall": "node scripts/setup.js",
    "spec": "node scripts/spec.js",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "video-editor",
    "nle",
    "timeline",
    "ffmpeg",
    "whisper",
    "edl",
    "web-components",
    "hybrids",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "description": "Browser-based, Vegas-style video editor with an AI director — JSON EDL state, canvas timeline, local media analysis, FFmpeg render",
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@fontsource/playfair-display": "^5.3.0",
    "@napi-rs/canvas": "^1.2.1",
    "@techninja/clearstack": "^0.3.27",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "hybrids": "^9.1.22",
    "jsonrepair": "^3.14.0",
    "lucide-static": "^1.7.0",
    "ws": "^8.0.0"
  },
  "type": "module",
  "imports": {
    "#store/*": "./src/store/*",
    "#utils/*": "./src/utils/*",
    "#atoms/*": "./src/components/atoms/*",
    "#molecules/*": "./src/components/molecules/*",
    "#organisms/*": "./src/components/organisms/*",
    "#templates/*": "./src/components/templates/*",
    "#pages/*": "./src/pages/*"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@techninja/clearstack": "^0.3.27",
    "@types/node": "^22.0.0",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-unused-imports": "^4.0.0",
    "markdownlint-cli2": "^0.22.0",
    "playwright": "^1.50.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techninja/nearedit.git"
  }
}
